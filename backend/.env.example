# Copy to backend/.env and fill in. Never commit .env.

# Which provider serves requests: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq free tier — https://console.groq.com/keys
# Covers generation, Whisper transcription and vision with one key.
GROQ_API_KEY=

# Local fallback. Requires: ollama pull qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct

ENVIRONMENT=development
