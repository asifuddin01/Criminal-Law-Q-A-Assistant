# Data — raw scrapes and built indexes are reproducible, never committed
data/raw/
data/interim/
data/index/
data/cache/
# Derived from the Schedule II PDF by `python -m app.ingest.precompute`, the same
# way the other data/ directories are derived. The container regenerates it at
# build time; locally, run that command once to cut ~25s off every start.
data/parsed/
*.sqlite
*.duckdb

# Model caches
.cache/
models/

# Eval outputs — results are committed, scratch runs are not
eval/runs/scratch/

# OS / editor / tooling
.DS_Store
.idea/
.vscode/
.claude/

# Next.js build output
frontend/.next/
frontend/next-env.d.ts

# Built frontend, copied in by the Docker build. Not a source artefact.
backend/static/
